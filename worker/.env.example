# Supabase > Settings > API (service_role anahtarı; yalnızca sunucuda kullanılır)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Konuşmayı yazıya dökme: groq (ücretsiz kota) veya openai
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=

# Web uygulamasının worker'ı uyandırmak için kullandığı ortak şifre
WORKER_SHARED_SECRET=uzun-rastgele-bir-sifre

# Instagram için çerez dosyası (isteğe bağlı). README'ye bakın.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=

# Limitler
DAILY_IMPORT_LIMIT=20
MAX_VIDEO_SECONDS=600
MAX_VIDEO_MB=200
MAX_FRAMES=8
WORKER_POLL_SECONDS=5
TMP_DIR=/app/tmp
