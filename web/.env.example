# Supabase projesi > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Yalnızca sunucuda kullanılır, tarayıcıya ASLA gitmez
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Kullanıcı başına günlük link ekleme limiti
DAILY_IMPORT_LIMIT=20

# Render'daki worker adresi (iş eklendiğinde uyandırmak için)
WORKER_URL=https://tarif-worker.onrender.com
WORKER_SHARED_SECRET=uzun-rastgele-bir-sifre

# Uygulamanın kendi adresi (giriş yönlendirmeleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
